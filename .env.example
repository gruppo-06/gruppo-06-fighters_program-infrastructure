# Copy to .env and adjust. Never commit .env.

# Where the other repositories are (default: next to this one)
# BACKEND_DIR=../gruppo-06-fighters_program-backend
# FRONTEND_DIR=../gruppo-06-fighters_program-frontend

# JWT signing key, at least 32 characters. If empty, scripts/dev.sh generates one and keeps it locally.
JWT_SECRET=

# Initial admin account created at startup (leave empty for none). Password: at least 12 characters.
ADMIN_EMAIL=admin@fighters.demo
ADMIN_PASSWORD=
ADMIN_NICKNAME=admin

# Advanced mode (speed, dodge, critical hits, sub-cards)
GAME_ADVANCED_ENABLED=true

# Folder with the card illustrations served by the backend (default: ~/.local/share/fighters-dev/card-images)
# CARD_IMAGES_LOCATION=

# Ports of the containers
POSTGRES_PORT=5432
REDIS_PORT=6379

# Backend URL used by the frontend
VITE_API_URL=http://localhost:8080/api
